rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed model (all dates are Firestore Timestamp values):
    // perfiles/{uid}: uid, private nombre/correo/rol, creadoEn.
    // perfilesPublicos/{uid}: uid, nombre and immutable creadoEn only.
    // perfiles/{uid}/asignaturas/{asignaturaId}: professor-course assignment.
    // perfiles/{uid}/locks/horarios: server-only lock for serialized slot creation.
    // asignaturas/{id}: nombre, activa.
    // horarios/{id}: professor/course IDs and display names, inicio, fin,
    //   reservado, tieneHistorial, activo, creadoEn, optional reservaId.
    // reservas/{id}: schedule/student/professor IDs and display names,
    //   course name, inicio, fin, estado, creadaEn, actualizadaEn.
    // Domain writes go through trusted callable functions. Client SDK writes
    // are allowed only for a verified student's paired private/public profile.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDocOwner(uid) {
      return isOwner(uid) && resource.data.uid == uid;
    }

    function uidUnchanged(uid, data) {
      return data.uid == uid;
    }

    function uidNotModified(newData, oldData) {
      return newData.uid == oldData.uid;
    }

    function isUniversityMember() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[A-Za-z0-9._%+-]+@uao\\.edu\\.co$');
    }

    function hasOnlyFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function validName(name, minimum) {
      return name is string && name.size() >= minimum && name.size() <= 100;
    }

    function isValidPrivateProfile(uid, data) {
      return data is map
        && hasOnlyFields(data, ['uid', 'nombre', 'correo', 'rol', 'creadoEn'])
        && hasRequiredFields(data, ['uid', 'nombre', 'correo', 'rol', 'creadoEn'])
        && uidUnchanged(uid, data)
        && data.uid is string
        && data.uid.size() <= 128
        && validName(data.nombre, 3)
        && data.correo is string
        && data.correo.size() <= 254
        && data.correo == request.auth.token.email
        && data.rol in ['estudiante', 'profesor']
        && data.creadoEn is timestamp;
    }

    function isValidPublicProfile(uid, data) {
      return data is map
        && hasOnlyFields(data, ['uid', 'nombre', 'creadoEn'])
        && hasRequiredFields(data, ['uid', 'nombre', 'creadoEn'])
        && uidUnchanged(uid, data)
        && data.uid is string
        && data.uid.size() <= 128
        && validName(data.nombre, 3)
        && data.creadoEn is timestamp;
    }

    function publicNameMatches(uid, name) {
      return getAfter(/databases/$(database)/documents/perfilesPublicos/$(uid)).data.nombre == name;
    }

    function privateNameMatches(uid, name) {
      return getAfter(/databases/$(database)/documents/perfiles/$(uid)).data.nombre == name;
    }

    function isReservationParticipant() {
      return isUniversityMember()
        && (resource.data.estudianteId == request.auth.uid
          || resource.data.profesorId == request.auth.uid);
    }

    // Private profile: email and role are readable only by the account owner.
    match /perfiles/{uid} {
      allow get: if isOwner(uid) && isUniversityMember();
      allow list: if false;

      allow create: if isOwner(uid)
        && isUniversityMember()
        && isValidPrivateProfile(uid, request.resource.data)
        && request.resource.data.rol == 'estudiante'
        && request.resource.data.creadoEn == request.time
        && publicNameMatches(uid, request.resource.data.nombre);

      allow update: if isOwner(uid)
        && isUniversityMember()
        && isDocOwner(uid)
        && isValidPrivateProfile(uid, request.resource.data)
        && uidNotModified(request.resource.data, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.creadoEn == resource.data.creadoEn
        && publicNameMatches(uid, request.resource.data.nombre);

      allow delete: if false;

      // Professors can read only their own subject assignments. Admin tools
      // maintain these documents through the Admin SDK.
      match /asignaturas/{asignaturaId} {
        allow get, list: if isOwner(uid) && isUniversityMember();
        allow create, update, delete: if false;
      }
    }

    // Public-to-campus display name only; no email or account metadata.
    match /perfilesPublicos/{uid} {
      allow read: if isUniversityMember();

      allow create: if isOwner(uid)
        && isUniversityMember()
        && isValidPublicProfile(uid, request.resource.data)
        && request.resource.data.creadoEn == request.time
        && privateNameMatches(uid, request.resource.data.nombre);

      allow update: if isOwner(uid)
        && isUniversityMember()
        && isDocOwner(uid)
        && isValidPublicProfile(uid, request.resource.data)
        && uidNotModified(request.resource.data, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
        && request.resource.data.creadoEn == resource.data.creadoEn
        && privateNameMatches(uid, request.resource.data.nombre);

      allow delete: if false;
    }

    // These authenticated documents contain no email or private profile data.
    // Their writes are reserved for trusted administration and callable functions.
    match /asignaturas/{asignaturaId} {
      allow read: if isUniversityMember() && resource.data.activa == true;
      allow create, update, delete: if false;
    }

    match /horarios/{horarioId} {
      allow read: if isUniversityMember();
      allow create, update, delete: if false;
    }

    // Booking documents include both participants' names. Queries must be
    // scoped by estudianteId == request.auth.uid or profesorId == request.auth.uid.
    match /reservas/{reservaId} {
      allow read: if isReservationParticipant();
      allow create, update, delete: if false;
    }

    // Default deny for every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
